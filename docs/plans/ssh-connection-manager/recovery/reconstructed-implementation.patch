+      bootstrap_identity_id: bootstrap.id,
+    });
+    expect(enrollment.state).toBe("verified");
+    await backend.restart();
+    route = await request<SSHRoute>(root);
+    expect(route.latest_enrollment?.state).toBe("verified");
