+	s, _ := identityService(t)
+	router := managerRouter(s, &authn.Identity{UserID: "admin", Role: authn.RoleAdmin})
+	req := CreateIdentityRequest{RequestID: uuid.NewString(), Label: "generated", Kind: "generate"}
+	body, err := json.Marshal(req)
