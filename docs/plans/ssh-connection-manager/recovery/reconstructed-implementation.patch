+	}
+	if updated.Stamp != first.Stamp {
+		t.Fatal("label changed route")
+	}
+	if _, err = s.store.db.Exec(`DROP TABLE ssh_connection_audit`); err != nil {
+		t.Fatal(err)
+	}
