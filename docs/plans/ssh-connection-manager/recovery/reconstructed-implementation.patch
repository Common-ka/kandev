+          {t("settings:sshManager.createBastion")}
+        </Button>
+      )}
+      {!route || dirty ? (
+        <p className="mt-4 text-sm text-muted-foreground">{t("settings:sshManager.saveFirst")}</p>
+      ) : (
+        <ConnectionTrust
+          route={route}
+          manager={manager}
+          observation={observation}
+          setObservation={setObservation}
+        />
+      )}
+      {route && !dirty && <PrerequisitePanel route={route} manager={manager} />}
+      {route && !dirty && <EnrollmentPanel route={route} manager={manager} />}
+      {route && (
+        <div className="mt-6">
+          <ManagerConfirmation
+            label={t("settings:sshManager.deleteConnection")}
+            title={t("settings:sshManager.deleteConnection")}
