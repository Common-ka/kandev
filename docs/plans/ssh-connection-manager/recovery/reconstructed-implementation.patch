-func (c *sshProxyJumpConn) Close() error {
-	if c == nil {
-		return nil
-	}
-	c.once.Do(func() {
-		var bastionErr, tunnelErr error
-		if c.bastion != nil {
-			bastionErr = c.bastion.Close()
-		}
-		if c.Conn != nil {
-			tunnelErr = c.Conn.Close()
-		}
-		c.closeErr = errors.Join(bastionErr, tunnelErr)
