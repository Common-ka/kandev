+		t.Fatalf("retry created a new connection: %v", err)
+	}
+	req.Connection.Host = "different"
+	if _, err = s.SaveConnection(ctx, req); !errors.Is(err, ErrConflict) {
+		t.Fatalf("request reuse = %v", err)
