  "sourceFiles": [
    {
      "path": "apps/web/e2e/helpers/dense-compositing-diagnostics.ts",
      "sha256": "0e80763096181bdecd4745c40264e830f51ad1337449dc42668ff5efeb4afb89",
      "content": "import { expect, type Page } from \"@playwright/test\";\n\ntype Layer = {\n  layerId: string;\n  backendNodeId?: number;\n  drawsContent: boolean;\n  width: number;\n  height: number;\n};\n\n/** Attribution only: enabling the layer domain and reading styles can change timing. */\nexport async function inspectDenseCompositing(page: Page, selector: string) {\n  const cdp = await page.context().newCDPSession(page);\n  let layers: Layer[] = [];\n  cdp.on(\"LayerTree.layerTreeDidChange\", (event) => {\n    layers = event.layers ?? [];\n  });\n  try {\n    await cdp.send(\"DOM.enable\");\n    await cdp.send(\"LayerTree.enable\");\n    await page.screenshot();\n    await expect.poll(() => layers.length).toBeGreaterThan(0);\n    const { root } = await cdp.send(\"DOM.getDocument\");\n    const { nodeIds } = await cdp.send(\"DOM.querySelectorAll\", { nodeId: root.nodeId, selector });\n    const styles = await page.locator(selector).evaluateAll((elements) =>\n      elements.map((element) => {\n        const style = getComputedStyle(element);\n        return {\n          className: element.getAttribute(\"class\"),\n          testId: element.getAttribute(\"data-testid\"),\n          width: style.width,\n          height: style.height,\n          zoom: style.zoom,\n          willChange: style.willChange,\n          animations: element.getAnimations().map((animation) => ({\n            state: animation.playState,\n            properties:\n              animation.effect instanceof KeyframeEffect\n                ? [...new Set(animation.effect.getKeyframes().flatMap(Object.keys))]\n                : [],\n          })),\n        };\n      }),\n    );\n    const targets = [];\n    for (const [index, nodeId] of nodeIds.entries()) {\n      const { node } = await cdp.send(\"DOM.describeNode\", { nodeId });\n      const owned = [];\n      for (const layer of layers.filter((item) => item.backendNodeId === node.backendNodeId)) {\n        const reasons = await cdp.send(\"LayerTree.compositingReasons\", { layerId: layer.layerId });\n        owned.push({\n          ...layer,\n          reasons: reasons.compositingReasons,\n          reasonIds: reasons.compositingReasonIds,\n        });\n      }\n      targets.push({\n        tag: node.nodeName,\n        backendNodeId: node.backendNodeId,\n        ...styles[index],\n        layers: owned,\n      });\n    }\n    return { layerCount: layers.length, targets };\n  } finally {\n    await cdp.detach();\n  }\n}\n"
    },
    {
      "path": "apps/web/e2e/tests/performance/dense-compositing-diagnostics.spec.ts",
      "sha256": "45985e909337785d7a67baa32ec9653d6399819fb01275820edf5033cc2d76e8",
      "content": "import { test, expect } from \"@playwright/test\";\nimport { inspectDenseCompositing } from \"../../helpers/dense-compositing-diagnostics\";\n\ntest(\"attributes compositor layers to the actual animation targets\", async ({ page }) => {\n  await page.setContent(`\n    <style>\n      @keyframes spin { to { transform: rotate(360deg) } }\n      .target { width: 14px; height: 14px; animation: spin 1s linear infinite }\n      div.target { background: blue }\n    </style>\n    <div class=\"target\"></div>\n    <svg class=\"target\" viewBox=\"0 0 24 24\"><path d=\"M12 2a10 10 0 1 1-10 10\" /></svg>\n  `);\n  const result = await inspectDenseCompositing(page, \".target\");\n  expect(result.targets.map((target) => target.tag.toLowerCase())).toEqual([\"div\", \"svg\"]);\n  expect(result.targets[0].layers.flatMap((layer) => layer.reasons)).toContain(\n    \"Has an active accelerated transform animation or transition.\",\n  );\n});\n"
    }
  ],
